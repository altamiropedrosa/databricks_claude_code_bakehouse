{
  "datasets": [
    {
      "name": "ds_daily",
      "displayName": "Vendas diarias por franquia",
      "queryLines": [
        "SELECT transaction_date, franchise_id, franchise_name, city, country, payment_method, ",
        "orders, units_sold, revenue ",
        "FROM daily_sales_by_franchise"
      ],
      "columns": [
        {
          "displayName": "Receita",
          "description": "Receita total",
          "expression": "SUM(`revenue`)"
        },
        {
          "displayName": "Pedidos",
          "description": "Numero de pedidos (transacoes)",
          "expression": "SUM(`orders`)"
        },
        {
          "displayName": "Ticket Medio",
          "description": "Receita / pedidos",
          "expression": "SUM(`revenue`) / SUM(`orders`)"
        },
        {
          "displayName": "Franquias Ativas",
          "description": "Franquias com ao menos uma venda no periodo",
          "expression": "COUNT(DISTINCT `franchise_id`)"
        }
      ]
    },
    {
      "name": "ds_product",
      "displayName": "Vendas por produto",
      "queryLines": [
        "SELECT product, transaction_date, country, orders, units_sold, revenue ",
        "FROM sales_by_product"
      ]
    },
    {
      "name": "ds_franchise",
      "displayName": "Desempenho das franquias",
      "queryLines": [
        "SELECT revenue_rank, franchise_id, franchise_name, city, country, size, latitude, longitude, ",
        "orders, units_sold, revenue, avg_ticket, unique_customers ",
        "FROM franchise_performance ",
        "ORDER BY revenue_rank"
      ]
    },
    {
      "name": "ds_sentiment",
      "displayName": "Sentimento por franquia",
      "queryLines": [
        "SELECT franchise_name, city, country, reviews, positive_reviews, negative_reviews, ",
        "mixed_reviews, neutral_reviews, positive_ratio, net_sentiment ",
        "FROM sentiment_by_franchise ",
        "WHERE reviews > 0 ",
        "ORDER BY net_sentiment DESC, reviews DESC"
      ]
    },
    {
      "name": "ds_sentiment_mix",
      "displayName": "Mix de sentimento por pais",
      "queryLines": [
        "SELECT country, sentiment, review_count FROM ( ",
        "SELECT country, stack(4, ",
        "'Positivo', positive_reviews, 'Misto', mixed_reviews, ",
        "'Neutro', neutral_reviews, 'Negativo', negative_reviews) AS (sentiment, review_count) ",
        "FROM sentiment_by_franchise)"
      ]
    }
  ],
